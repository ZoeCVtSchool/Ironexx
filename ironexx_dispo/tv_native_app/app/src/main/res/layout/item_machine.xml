<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#111C2E"
    android:padding="18dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/machineIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_machine"
        android:contentDescription="Máquina" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/machineName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textColor="#F8FAFC"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/machinePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0"
            android:textColor="#D4AF62"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/machineBranch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sucursal"
            android:textColor="#CBD5E1"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
